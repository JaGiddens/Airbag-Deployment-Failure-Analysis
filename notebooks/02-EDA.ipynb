    "unique_accidents = df.drop_duplicates(subset='CASENUM')\n",
    "\n",
    "# Count accidents by region\n",
    "region_counts = unique_accidents['REGIONNAME'].value_counts()\n",
    "\n",
    "# Create the pie chart\n",
    "plt.figure(figsize=(12, 6))\n",
    "\n",
    "wedges, texts, autotexts = plt.pie(region_counts.values, \n",
    "                                     autopct='%1.1f%%',\n",
    "                                     startangle=90)\n",
    "\n",
    "plt.title('Distribution of Accidents by Region', fontsize=14, fontweight='bold')\n",
    "plt.axis('equal')\n",
    "\n",
    "# Add legend with region names\n",
    "plt.legend(wedges, region_counts.index, \n",
    "          title=\"Regions\",\n",
    "          loc=\"center left\",\n",
    "          bbox_to_anchor=(1, 0, 0.5, 1),\n",
    "          fontsize=10)\n",
    "\n",
    "plt.tight_layout()\n",
    "\n",
    "# save plot\n",
    "file_name = \"accident_region_pie_chart.png\"\n",
    "file_path = os.path.join(folder_name, file_name)\n",
    "\n",
    "plt.savefig(file_path)\n",
    "plt.show()"
   ]
  }
