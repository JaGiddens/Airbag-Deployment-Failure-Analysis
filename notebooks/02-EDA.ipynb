    "  'WEATHER',\n",
    "  'LGT_COND',\n",
    "  'NUM_INJ',   # number injured in crash     \n",
    "  'AVG_AGE',\n",
    "  'FRONT_MOST_SEAT_POS', # seat position\n",
    "  'ANY_UNRESTRAINED', # restraint use (seatbelts, etc)\n",
    "  'ALL_AIRBAGS_DEPLOYED', # target var, air bag use\n",
    "  'MAKE',              \n",
    "  'BODY_TYP',           \n",
    "  'IMPACT1',# initial contact point\n",
    "  'P_CRASH1', # pre event movement \n",
