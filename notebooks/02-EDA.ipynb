    "h_ab = df.groupby(['HARM_EVNAME', 'ALL_AIRBAGS_DEPLOYED']).size().reset_index(name='Count')\n",
    "\n",
    "# Sort before plotting\n",
    "h_ab = h_ab.sort_values(\"Count\", ascending=False)\n",
    "\n",
    "plt.figure(figsize=(18,6))\n",
    "sns.barplot(\n",
    "    data=h_ab, \n",
    "    x=\"HARM_EVNAME\", \n",
    "    y=\"Count\", \n",
    "    hue=\"ALL_AIRBAGS_DEPLOYED\", \n",
    "    dodge=True\n",
    ")\n",
    "plt.xticks(rotation=50)\n",
    "plt.title(\"Airbag Deployment Rate by Most Harmful Event\")\n",
    "plt.legend(title='Airbag(s) Deployed')\n",
    "\n",
    "# save plot\n",
    "file_name = \"airbag_deployment_by_harm_ev.png\"\n",
    "file_path = os.path.join(folder_name, file_name)\n",
    "\n",
    "plt.savefig(file_path)\n",
    "plt.show()"
   ]
